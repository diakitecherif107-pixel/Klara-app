  out.style.display='block';
  res.innerHTML='<div style="display:flex;align-items:center;gap:0.75rem;font-size:0.8rem"><div class="spinner"></div> Génération...</div>';
  try{const result=await callClaude(`Devis freelance pour : ${desc}. Date: 24 mai 2026.`);res.innerHTML=result.replace(/\n/g,'<br>')}
  catch(e){res.innerHTML='<span style="color:var(--red)">Erreur.</span>'}
}
function copyDevis(){const el=document.querySelector('#ia-output .ai-result');if(el)navigator.clipboard.writeText(el.innerText).then(()=>showToast('📋 Copié !'))}

// ========== SCROLL REVEAL ==========
const obs=new IntersectionObserver((entries)=>{entries.forEach((e,i)=>{if(e.isIntersecting){setTimeout(()=>e.target.classList.add('visible'),i*80);obs.unobserve(e.target)}})},{threshold:0.1,rootMargin:'0px 0px -40px 0px'});
document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));

// ========== STATS COUNTER ==========
const sObs=new IntersectionObserver((entries)=>{
  if(entries[0].isIntersecting){
    document.querySelectorAll('[data-target]').forEach(el=>{
      const target=+el.dataset.target,suffix=el.dataset.suffix||'';
      let start=null;
      const step=(t)=>{if(!start)start=t;const p=Math.min((t-start)/1800,1),e2=1-Math.pow(1-p,3);el.textContent=Math.floor(e2*target)+suffix;if(p<1)requestAnimationFrame(step)};
      requestAnimationFrame(step);
    });sObs.disconnect();
  }},{threshold:0.5});
const statsEl=document.querySelector('.stats-section');
if(statsEl)sObs.observe(statsEl);

// ========== INIT ==========
renderDevis();renderFactures();renderClients();renderRelances();
</script>
