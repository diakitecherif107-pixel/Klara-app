/* ============ PAGES ============ */
.page{display:none;min-height:100vh}
.page.active{display:block}

/* ============ NAV ============ */
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:1.1rem 4rem;display:flex;align-items:center;justify-content:space-between;transition:all 0.4s;background:rgba(240,245,255,0.9);backdrop-filter:blur(20px);border-bottom:1px solid var(--border)}
.logo{font-family:'DM Serif Display',serif;font-size:1.6rem;color:var(--blue-dark);cursor:pointer;letter-spacing:-0.02em}
.logo em{color:var(--blue-light);font-style:italic}
.nav-links{display:flex;align-items:center;gap:2rem;list-style:none}
.nav-links a{color:var(--muted);text-decoration:none;font-size:0.875rem;transition:color 0.2s;cursor:pointer}
.nav-links a:hover{color:var(--cream)}
.nav-btn{background:var(--gold);color:#fff !important;padding:0.5rem 1.25rem;border-radius:4px;font-size:0.85rem;font-weight:600 !important;transition:all 0.2s !important}
.nav-btn:hover{background:#b45309 !important;transform:translateY(-1px)}

/* ============ HERO ============ */
.hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:8rem 2rem 4rem;position:relative;overflow:hidden}
.grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(37,99,235,0.08) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,0.08) 1px,transparent 1px);background-size:60px 60px;mask-image:radial-gradient(ellipse 80% 80% at 50% 50%,black,transparent)}
.glow{position:absolute;width:700px;height:700px;background:radial-gradient(circle,rgba(37,99,235,0.08),transparent 70%);top:0;left:50%;transform:translateX(-50%);pointer-events:none}
.hero-badge{display:inline-flex;align-items:center;gap:0.5rem;background:rgba(37,99,235,0.08);border:1px solid rgba(37,99,235,0.2);color:var(--blue);font-size:0.72rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;padding:0.45rem 1.1rem;border-radius:100px;margin-bottom:2rem;position:relative;z-index:1}
.badge-dot{width:6px;height:6px;background:var(--green);border-radius:50%;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(5,150,105,0.4)}50%{box-shadow:0 0 0 6px rgba(5,150,105,0)}}
h1{font-family:'DM Serif Display',serif;font-size:clamp(3rem,7vw,6rem);line-height:1.06;letter-spacing:-0.04em;color:var(--cream);max-width:900px;position:relative;z-index:1}
h1 em{background:linear-gradient(135deg,var(--blue),var(--blue-light));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;font-style:italic}
.hero-desc{font-size:clamp(1rem,2vw,1.15rem);color:var(--muted);max-width:520px;margin-top:1.5rem;line-height:1.7;position:relative;z-index:1}
.hero-cta{display:flex;align-items:center;gap:1rem;margin-top:2.5rem;flex-wrap:wrap;justify-content:center;position:relative;z-index:1}
.btn-primary{background:var(--blue);color:#fff;padding:0.9rem 2.2rem;border-radius:5px;font-size:0.95rem;font-weight:500;text-decoration:none;transition:all 0.25s;display:inline-flex;align-items:center;gap:0.5rem;border:none;cursor:pointer;font-family:inherit}
.btn-primary:hover{background:var(--blue-dark);transform:translateY(-2px);box-shadow:0 12px 40px rgba(37,99,235,0.25)}
.btn-gold{background:var(--gold);color:#fff;padding:0.9rem 2.2rem;border-radius:5px;font-size:0.95rem;font-weight:600;text-decoration:none;transition:all 0.25s;display:inline-flex;align-items:center;gap:0.5rem;border:none;cursor:pointer;font-family:inherit}
.btn-gold:hover{background:#b45309;transform:translateY(-2px);box-shadow:0 12px 40px rgba(217,119,6,0.3)}
.btn-ghost{color:var(--muted);font-size:0.9rem;text-decoration:none;display:inline-flex;align-items:center;gap:0.5rem;transition:color 0.2s;background:none;border:none;cursor:pointer;font-family:inherit}
.btn-ghost:hover{color:var(--cream)}
.social-proof{display:flex;align-items:center;gap:1rem;margin-top:2.5rem;position:relative;z-index:1}
.avatars{display:flex}
.av{width:34px;height:34px;border-radius:50%;border:2px solid var(--bg);display:flex;align-items:center;justify-content:center;font-size:0.7rem;font-weight:600;color:#fff;margin-left:-8px}
.av:first-child{margin-left:0}
.proof-text{font-size:0.78rem;color:var(--muted)}
.proof-text strong{color:var(--cream)}

/* ============ MOCKUP ============ */
.preview-wrap{width:100%;max-width:960px;margin:4rem auto 0;padding:0 2rem;position:relative;z-index:1}
.preview{background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden;box-shadow:0 20px 60px rgba(37,99,235,0.12),0 0 0 1px rgba(37,99,235,0.05)}
.preview-topbar{display:flex;align-items:center;gap:0.5rem;padding:0.875rem 1.25rem;border-bottom:1px solid var(--border);background:var(--bg2)}
.dot{width:10px;height:10px;border-radius:50%}
.dr{background:#ff5f56}.dy{background:#ffbd2e}.dg{background:#27c93f}
.preview-url{margin-left:1rem;background:var(--surface);border:1px solid var(--border);border-radius:4px;padding:0.25rem 1rem;font-size:0.7rem;color:var(--muted);flex:1;max-width:280px}
.preview-body{display:grid;grid-template-columns:190px 1fr;min-height:320px}
.prev-sidebar{border-right:1px solid var(--border);padding:1.25rem 0.875rem;background:var(--bg2)}
.prev-logo{font-family:'DM Serif Display',serif;font-size:1rem;color:var(--blue-dark);padding:0 0.5rem;margin-bottom:1.25rem}
.prev-logo em{color:var(--blue-light);font-style:italic}
.prev-item{display:flex;align-items:center;gap:0.5rem;padding:0.45rem 0.625rem;border-radius:4px;font-size:0.72rem;color:var(--muted);margin-bottom:0.1rem}
.prev-item.act{background:rgba(37,99,235,0.1);color:var(--blue)}
.prev-main{padding:1.25rem;background:var(--surface)}
.prev-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem;margin-bottom:1.25rem}
.prev-kpi{background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:0.875rem}
.prev-kpi-label{font-size:0.58rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em}
.prev-kpi-val{font-family:'DM Serif Display',serif;font-size:1.3rem;color:var(--cream);margin-top:0.2rem}
.prev-kpi-change{font-size:0.6rem;color:var(--green);margin-top:0.1rem}
.prev-table{border:1px solid var(--border);border-radius:6px;overflow:hidden}
.prev-th{display:grid;grid-template-columns:2fr 1fr 1fr;font-size:0.58rem;color:var(--muted);text-transform:uppercase;padding:0.6rem 1rem;border-bottom:1px solid var(--border);background:var(--bg2)}
.prev-tr{display:grid;grid-template-columns:2fr 1fr 1fr;font-size:0.7rem;padding:0.55rem 1rem;border-bottom:1px solid var(--border);color:var(--text);opacity:0;animation:rowIn 0.4s ease forwards}
.prev-tr:last-child{border-bottom:none}
.prev-tr:nth-child(1){animation-delay:1s}
.prev-tr:nth-child(2){animation-delay:1.3s}
.prev-tr:nth-child(3){animation-delay:1.6s}
@keyframes rowIn{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:translateX(0)}}
.tbadge{display:inline-block;padding:0.15rem 0.5rem;border-radius:100px;font-size:0.6rem;font-weight:500}
.bg{background:rgba(5,150,105,0.1);color:var(--green)}
.by{background:rgba(217,119,6,0.1);color:var(--gold)}
.br{background:rgba(220,38,38,0.1);color:var(--red)}

/* ============ STATS ============ */
.stats-section{display:flex;justify-content:center;flex-wrap:wrap;border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--surface)}
.stat-item{text-align:center;padding:2.5rem 4rem;border-right:1px solid var(--border)}
.stat-item:last-child{border-right:none}
.stat-num{font-family:'DM Serif Display',serif;font-size:2.8rem;color:var(--blue);line-height:1;display:block}
.stat-label{font-size:0.75rem;color:var(--muted);margin-top:0.35rem}

/* ============ CALCULATOR ============ */
.calc-section{padding:7rem 2rem;background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.section-inner{max-width:1100px;margin:0 auto}
.section-tag{display:inline-flex;align-items:center;gap:0.5rem;font-size:0.68rem;text-transform:uppercase;letter-spacing:0.15em;color:var(--blue);margin-bottom:1rem}
.section-tag::before{content:'';width:24px;height:1px;background:var(--blue)}
h2{font-family:'DM Serif Display',serif;font-size:clamp(2rem,4vw,3rem);line-height:1.1;letter-spacing:-0.03em;color:var(--cream)}
h2 em{background:linear-gradient(135deg,var(--blue),var(--blue-light));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;font-style:italic}
.section-desc{color:var(--muted);max-width:500px;margin-top:1rem;font-size:1rem;line-height:1.7}

.calc-wrap{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-top:3rem;box-shadow:0 8px 30px rgba(37,99,235,0.08)}
.calc-header{background:linear-gradient(135deg,var(--blue),var(--blue-light));padding:2rem;color:#fff;text-align:center}
.calc-header-title{font-family:'DM Serif Display',serif;font-size:1.5rem;margin-bottom:0.5rem}
.calc-header-desc{font-size:0.85rem;opacity:0.85}
.calc-body{display:grid;grid-template-columns:1fr 1fr;gap:0}

.calc-inputs{padding:2.5rem;border-right:1px solid var(--border)}
.calc-title{font-size:0.78rem;font-weight:600;color:var(--cream);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:1.5rem}

.slider-group{margin-bottom:2rem}
.slider-label{display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem}
.slider-name{font-size:0.85rem;color:var(--text)}
.slider-value{font-family:'DM Serif Display',serif;font-size:1.1rem;color:var(--blue);font-weight:600}
.slider{width:100%;height:4px;border-radius:2px;background:var(--border);outline:none;-webkit-appearance:none;cursor:pointer}
.slider::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:50%;background:var(--blue);cursor:pointer;box-shadow:0 2px 8px rgba(37,99,235,0.3)}
.slider-hints{display:flex;justify-content:space-between;font-size:0.65rem;color:var(--muted);margin-top:0.4rem}

.calc-results{padding:2.5rem;background:var(--bg)}
.result-main{background:linear-gradient(135deg,var(--blue),var(--blue-light));border-radius:10px;padding:2rem;text-align:center;margin-bottom:1.5rem;color:#fff}
.result-label{font-size:0.75rem;text-transform:uppercase;letter-spacing:0.1em;opacity:0.85;margin-bottom:0.5rem}
.result-value{font-family:'DM Serif Display',serif;font-size:3.5rem;line-height:1;margin-bottom:0.25rem}
.result-sub{font-size:0.8rem;opacity:0.8}

.result-breakdown{display:flex;flex-direction:column;gap:0.75rem;margin-bottom:1.5rem}
.result-row{display:flex;justify-content:space-between;align-items:center;padding:0.75rem 1rem;background:var(--surface);border:1px solid var(--border);border-radius:6px}
.result-row-label{font-size:0.8rem;color:var(--text);display:flex;align-items:center;gap:0.5rem}
.result-row-value{font-size:0.9rem;font-weight:500;color:var(--green)}

.roi-badge{background:rgba(5,150,105,0.1);border:1px solid rgba(5,150,105,0.2);border-radius:8px;padding:1rem;text-align:center}
.roi-label{font-size:0.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.25rem}
.roi-value{font-family:'DM Serif Display',serif;font-size:2rem;color:var(--green)}
.roi-desc{font-size:0.72rem;color:var(--muted);margin-top:0.25rem}

.calc-cta{padding:2rem;border-top:1px solid var(--border);text-align:center;background:var(--surface)}
.calc-cta-text{font-size:0.9rem;color:var(--muted);margin-bottom:1rem}
.calc-cta-text strong{color:var(--cream)}

/* ============ FEATURES ============ */
.features-section{padding:7rem 2rem}
.features-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-top:3.5rem}
.feature-card{background:var(--surface);padding:2.5rem;position:relative;overflow:hidden;transition:background 0.3s}
.feature-card:hover{background:var(--bg2)}
.feature-card::after{content:'';position:absolute;bottom:0;left:0;width:0;height:2px;background:linear-gradient(90deg,var(--blue),var(--blue-light));transition:width 0.4s}
.feature-card:hover::after{width:100%}
.f-num{font-family:'DM Serif Display',serif;font-size:3rem;color:rgba(37,99,235,0.1);line-height:1;margin-bottom:1rem;font-style:italic}
.f-icon{font-size:1.5rem;margin-bottom:0.875rem;display:block}
.f-title{font-size:0.95rem;font-weight:500;color:var(--cream);margin-bottom:0.5rem}
.f-desc{font-size:0.82rem;color:var(--muted);line-height:1.7}

/* ============ COMPARISON ============ */
.comparison-section{padding:7rem 2rem;background:var(--bg2);border-top:1px solid var(--border)}
.comparison-table{margin-top:3rem;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--surface)}
.comp-header{display:grid;grid-template-columns:2fr 1fr 1fr 1fr 1fr;background:var(--bg2);border-bottom:1px solid var(--border)}
.comp-th{padding:1rem 1.25rem;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted);text-align:center}
.comp-th:first-child{text-align:left}
.comp-th.klara{color:var(--blue);font-weight:600;background:rgba(37,99,235,0.05)}
.comp-row{display:grid;grid-template-columns:2fr 1fr 1fr 1fr 1fr;border-bottom:1px solid var(--border);align-items:center;transition:background 0.15s}
.comp-row:last-child{border-bottom:none}
.comp-row:hover{background:var(--bg)}
.comp-td{padding:0.875rem 1.25rem;font-size:0.8rem;color:var(--text);text-align:center}
.comp-td:first-child{text-align:left;color:var(--cream);font-weight:400}
.comp-td.klara{background:rgba(37,99,235,0.03)}
.check{color:var(--green);font-size:1rem}
.cross{color:var(--red);font-size:1rem;opacity:0.5}
.partial{color:var(--gold);font-size:0.75rem}

/* ============ TESTIMONIALS ============ */
.testi-section{padding:7rem 2rem}
.testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-top:3.5rem}
.testi-card{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:2rem;transition:all 0.3s}
.testi-card:hover{border-color:var(--border2);box-shadow:0 8px 30px rgba(37,99,235,0.08)}
.testi-stars{color:var(--gold);font-size:0.9rem;margin-bottom:1rem}
.testi-text{font-size:0.88rem;color:var(--text);line-height:1.75;font-style:italic}
.testi-author{display:flex;align-items:center;gap:0.75rem;margin-top:1.5rem}
.testi-av{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:600;color:#fff}
.testi-name{font-size:0.82rem;font-weight:500;color:var(--cream)}
.testi-role{font-size:0.7rem;color:var(--muted)}

/* ============ PRICING ============ */
.pricing-section{padding:7rem 2rem;background:var(--bg2);border-top:1px solid var(--border)}
.pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;max-width:900px;margin:3.5rem auto 0}
.price-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:2.5rem;position:relative;transition:all 0.3s}
.price-card:hover{box-shadow:0 8px 30px rgba(37,99,235,0.1)}
.price-card.featured{border-color:var(--blue);box-shadow:0 8px 30px rgba(37,99,235,0.15)}
.price-card.featured::before{content:'Le plus populaire';position:absolute;top:-1px;left:50%;transform:translateX(-50%);background:var(--blue);color:#fff;font-size:0.62rem;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;padding:0.3rem 1rem;border-radius:0 0 4px 4px;white-space:nowrap}
.price-name{font-size:0.72rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--muted);margin-bottom:1rem}
.price-amount{display:flex;align-items:flex-start;gap:0.25rem;line-height:1}
.price-currency{font-size:1.5rem;color:var(--cream);margin-top:0.3rem}
.price-value{font-family:'DM Serif Display',serif;font-size:3.2rem;color:var(--cream)}
.price-period{font-size:0.78rem;color:var(--muted);align-self:flex-end;margin-bottom:0.4rem}
.price-desc{font-size:0.78rem;color:var(--muted);margin:0.875rem 0 1.5rem}
.price-btn{display:block;text-align:center;padding:0.75rem;border-radius:4px;font-size:0.85rem;font-weight:500;cursor:pointer;border:none;width:100%;font-family:inherit;margin-bottom:1.5rem;transition:all 0.2s}
.price-btn-outline{background:transparent;border:1px solid var(--border2);color:var(--text)}
.price-btn-outline:hover{border-color:var(--blue);color:var(--blue)}
.price-btn-blue{background:var(--blue);color:#fff}
.price-btn-blue:hover{background:var(--blue-dark)}
.price-features{list-style:none;display:flex;flex-direction:column;gap:0.625rem}
.price-features li{display:flex;align-items:flex-start;gap:0.5rem;font-size:0.78rem;color:var(--muted)}
.price-features li::before{content:'✓';color:var(--blue-light);font-size:0.7rem;margin-top:0.1rem;flex-shrink:0}

/* ============ WAITLIST ============ */
.waitlist-page{padding:6rem 2rem;min-height:100vh;background:var(--bg)}
.waitlist-inner{max-width:620px;margin:0 auto}
.w-badge{display:inline-flex;align-items:center;gap:0.5rem;background:rgba(217,119,6,0.1);border:1px solid rgba(217,119,6,0.25);color:var(--gold);font-size:0.72rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;padding:0.45rem 1.1rem;border-radius:100px;margin-bottom:2rem}
.w-badge-dot{width:6px;height:6px;background:var(--gold);border-radius:50%;animation:pulse 2s infinite}
.w-title{font-family:'DM Serif Display',serif;font-size:clamp(2.5rem,5vw,3.5rem);line-height:1.08;letter-spacing:-0.04em;color:var(--cream);margin-bottom:1.25rem}
.w-title em{background:linear-gradient(135deg,var(--blue),var(--blue-light));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;font-style:italic}
.w-desc{font-size:1.05rem;color:var(--muted);line-height:1.7;margin-bottom:2.5rem}
.spots-bar{margin-bottom:2rem}
.spots-header{display:flex;justify-content:space-between;margin-bottom:0.5rem}
.spots-label{font-size:0.75rem;color:var(--muted)}
.spots-count{font-size:0.75rem;color:var(--red);font-weight:600}
.progress-track{height:6px;background:var(--border);border-radius:3px;overflow:hidden}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--blue),var(--blue-light));border-radius:3px;width:73%}
.offer-card{background:var(--surface);border:2px solid var(--blue);border-radius:12px;padding:2.5rem;position:relative;overflow:hidden;box-shadow:0 8px 30px rgba(37,99,235,0.12)}
.offer-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--blue),var(--blue-light))}
