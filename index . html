function updateCalc(){
  const temps=+document.getElementById('sl-temps').value;
  const taux=+document.getElementById('sl-taux').value;
  const impay=+document.getElementById('sl-impay').value;
  const montant=+document.getElementById('sl-montant').value;
  const devis=+document.getElementById('sl-devis').value;

  document.getElementById('val-temps').textContent=temps+'h';
  document.getElementById('val-taux').textContent=taux+'€/h';
  document.getElementById('val-impay').textContent=impay;
  document.getElementById('val-montant').textContent=montant.toLocaleString('fr-FR')+'€';
  document.getElementById('val-devis').textContent=devis;

  // Klara saves 70% of admin time
  const tempsGagne=Math.round(temps*0.7*4*taux);
  // Klara recovers 65% of unpaid invoices
  const impayRec=Math.round(impay*montant*0.65);
  // Klara converts 30% more quotes
  const devisConv=Math.round(devis*montant*0.3);
  const total=tempsGagne+impayRec+devisConv;
  const roi=Math.round(total/19);

  document.getElementById('res-temps').textContent='+'+tempsGagne.toLocaleString('fr-FR')+'€';
  document.getElementById('res-impay').textContent='+'+impayRec.toLocaleString('fr-FR')+'€';
  document.getElementById('res-devis').textContent='+'+devisConv.toLocaleString('fr-FR')+'€';
  document.getElementById('result-total').textContent=total.toLocaleString('fr-FR')+'€';
  document.getElementById('roi-value').textContent=roi+'x';
  document.getElementById('roi-gain').textContent=total.toLocaleString('fr-FR')+'€';
  document.getElementById('calc-cta-val').textContent=total.toLocaleString('fr-FR')+'€/mois';
}
