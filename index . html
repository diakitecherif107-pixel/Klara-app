<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f0f5ff;
  --bg2:#e8eeff;
  --surface:#ffffff;
  --border:#c8d8f5;
  --border2:#a8c0ef;
  --blue:#2563eb;
  --blue-light:#3b82f6;
  --blue-dark:#1d4ed8;
  --cream:#1e3a6e;
