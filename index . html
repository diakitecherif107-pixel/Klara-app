let spots=27;
async function handleSignup(){
  const fn=document.getElementById('w-firstName').value.trim();
  const ln=document.getElementById('w-lastName').value.trim();
  const em=document.getElementById('w-email').value.trim();
  const metier=document.getElementById('w-metier').value.trim();
  if(!fn||!ln||!em){showToast('⚠️ Remplis tous les champs');return}
  if(!em.includes('@')){showToast('⚠️ Email invalide');return}
  
  try {
    // Créer le compte dans Supabase
    const {data,error} = await klaraDB.auth.signUp({
      email: em,
      password: Math.random().toString(36).slice(-8)+'K!',
      options: {
        data: {
          first_name: fn,
          last_name: ln,
          metier: metier,
          plan: 'fondateur'
        }
      }
    });
    
    if(data.user || !error){
      // Sauvegarder dans la table users
      await klaraDB.from('users').insert([{
        email: em,
        nom: ln,
        prenom: fn,
        metier: metier,
        plan: 'fondateur',
        created_at: new Date().toISOString()
      }]);
    }
  } catch(e){console.log('Supabase signup:', e)}
  
  spots=Math.max(spots-1,0);
  document.getElementById('spotsLeft').textContent=`⚡ ${spots} places restantes sur 100`;
  showToast('🎉 Bienvenue parmi les fondateurs !');
  setTimeout(()=>window.location.href='https://buy.stripe.com/6oUeVcdCL8IAb61fAzfQI00',1500);
}
